{
  "name": "@vs-code-gpt/browser-worker",
  "version": "1.1.0-beta.6",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --runInBand",
    "test:unit": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --selectProjects browser-worker-unit",
    "test:integration": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --selectProjects browser-worker-integration",
    "test:e2e": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --selectProjects browser-worker-e2e",
    "test:watch": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --watch",
    "test:coverage": "node ../../tooling/testing/run-jest.mjs --config jest.config.ts --coverage"
  },
  "dependencies": {
    "@vs-code-gpt/shared": "0.1.0",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  }
}
